   sL4948  /* ===== v4.6.3 两段式互斥视图（核心配队 / 存档联动组队，纯视图切换、引擎零改动）=====
   sL4949  背景：点候选卡后方案渲染在长候选列表之下 → 用户以为点不动。
   sL4950  pick（挑选，默认）：工具栏 + 属性筛选 + 候选网格，仅此一屏；
   sL4951  detail（详情）：隐藏挑选屏，方案在原容器顶部 + 「← 返回挑选」（≥44px 触控）。
   sL4952  corePhase('pick') 只切 display、不触碰任何输入控件 → 搜索/筛选/排序状态天然保留。 */
   sL4953  var corePhaseMode='pick';
   sL4954  function corePhase(m){
   sL4955  corePhaseMode=(m==='detail')?'detail':'pick';
   sL4956  var pw=$('corePickWrap'),dw=$('coreDetailWrap');
   sL4957  if(pw&&pw.style)pw.style.display=(corePhaseMode==='pick')?'':'none';
   sL4958  if(dw&&dw.style)dw.style.display=(corePhaseMode==='detail')?'':'none';
   sL4959  if(corePhaseMode==='pick'&&window.drawCoreList)window.drawCoreList();
   sL4960  var host=$('tab-core');
   sL4961  if(host&&host.scrollIntoView){try{host.scrollIntoView({behavior:'smooth',block:'start'})}catch(e){}}
   sL4962  else{try{window.scrollTo(0,0)}catch(e){}}
   sL4963  }
   sL4964  var myPhaseMode='pick';
   sL4965  function myPhase(m,noscroll){
   sL4966  myPhaseMode=(m==='detail')?'detail':'pick';
   sL4967  var pw=$('myPickWrap'),dw=$('myDetailWrap');
   sL4968  if(pw&&pw.style)pw.style.display=(myPhaseMode==='pick')?'':'none';
   sL4969  if(dw&&dw.style)dw.style.display=(myPhaseMode==='detail')?'':'none';
   sL4970  if(noscroll)return;
   sL4971  var host=$('mySavCard');
   sL4972  if(host&&host.scrollIntoView){try{host.scrollIntoView({behavior:'smooth',block:'start'})}catch(e){}}
   sL4973  }
   sL4974  var coreSel=null;
   sL4975  function selectCore(id){
   sL4976  var s=ERDATA.species.filter(function(x){return x.id==id})[0];
   sL4977  if(!s)return;
   sL4978  coreSel=s;
   sL4979  switchTab('core');
   sL4980  renderCore(s);
   sL4981  corePhase('detail');
   sL4982  }
