   sL4985  function coreRoleOf(s){var k=''+s.id;if(!coreRoleCache[k])coreRoleCache[k]=coreRole(s).role;return coreRoleCache[k]}
   sL4986  function renderCoreTypes(){
   sL4987  var box=$('coreTypes');box.innerHTML='';
