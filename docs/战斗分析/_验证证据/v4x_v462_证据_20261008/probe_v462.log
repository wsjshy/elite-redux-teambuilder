================ 0. 静态实现原文（合图 + 两段式）================
   --- sprOf / spTag 区（script L840–856）---
   sL840  function closeSp(){spDrawer.classList.remove('open')}
   sL841  /* 精灵图（v4.6.2 合图 Sprite Sheet）：SPR_SHEET[id] = [sheetIdx, col, row]（由 sheets_map.js 构建期内嵌）。
   sL842  sprOf(id) 返回背景样式声明（sheet 背景图 + 尺寸无关定位：background-size 1600%（16 格）/ position 百分比）
   sL843  → 同一份标记在任意容器尺寸下正确缩放；id 缺失/无映射 → 返回空串，调用侧渲染 .spmiss 空占位（不发请求、不破版）。 */
   sL844  function sprOf(id){
   sL845  var c=(window.SPR_SHEET||{})[String(id)];
   sL846  if(!c)return '';
   sL847  return "background-image:url('assets/sheets/s"+c[0]+".webp');background-repeat:no-repeat;background-size:1600% 1600%;background-position:"+sppct(c[1])+" "+sppct(c[2]);
   sL848  }
   sL849  function sppct(k){return (Math.round(k*100/15*10000)/10000)+'%'}
   sL850  function sprEl(tag,id,cls){
   sL851  var st=sprOf(id);
   sL852  return '<'+tag+' class="'+(cls||'mcspr')+(st?'':' spmiss')+'" data-id="'+id+'"'+(st?' style="'+st+'"':'')+'></'+tag+'>';
   sL853  }
   sL854  function sprImg(id,cls){
   sL855  return '<span class="spbox '+(cls||'spcard')+'">'+sprEl('span',id,'spsp')+'</span>';
   sL856  }
