   sL4989  var b=tchip(t,!!coreFilter.types[t],function(){
   sL4990  coreFilter.types[t]=!coreFilter.types[t];
   sL4991  if(!coreFilter.types[t])delete coreFilter.types[t];
   sL4992  /* 交集筛选：宝可梦仅双属性，最多保留 2 个选中 */
   sL4993  var on=ERDATA.types.filter(function(x){return coreFilter.types[x]});
   sL4994  if(on.length>2)delete coreFilter.types[on[0]];
   sL4995  renderCoreTypes();draw();
